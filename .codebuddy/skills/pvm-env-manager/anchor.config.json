{
  "name": "pvm-env-manager",
  "schemaVersion": "1.0",
  "version": "2.0.0",
  "entry": "execute",
  "reads": ["RULE.mdc"],
  "anchors": [
    {
      "id": "detect",
      "dependsOn": [],
      "output": ".specflow/context/pvm-env.txt",
      "verify": {
        "producesExist": true,
        "producesFresh": true,
        "custom": [
          "bash .codebuddy/skills/pvm-env-manager/scripts/detect-env.sh"
        ]
      }
    },
    {
      "id": "install",
      "dependsOn": ["detect"],
      "consumes": [".specflow/context/pvm-env.txt"],
      "verify": {
        "review": {
          "output": ".specflow/context/pvm-install-report.json",
          "requireEvidence": true,
          "checklist": [
            {
              "id": "no-reinstall",
              "rule": "detect 输出 pvm_installed=true 时未重复安装，直接进入 execute",
              "mode": "model"
            },
            {
              "id": "arch-match",
              "rule": "新安装的资产与 detect 输出的 os/arch 完全一致，未硬编码 amd64",
              "mode": "model"
            },
            {
              "id": "pvm-runs",
              "rule": "安装后 pvm 可执行且 version 正常输出",
              "mode": "script",
              "command": "bash -lc 'h=\"${PVM_HOME:-$HOME/.pvm}\"; \"$h/bin/pvm\" version'"
            }
          ]
        }
      }
    },
    {
      "id": "execute",
      "dependsOn": ["install"],
      "verify": {
        "review": {
          "output": ".specflow/context/pvm-execute-report.json",
          "requireEvidence": true,
          "checklist": [
            {
              "id": "intent-mapping",
              "rule": "用户意图正确映射为 pvm 命令，命令以 references/pvm-commands.md 为准",
              "mode": "model"
            },
            {
              "id": "result-reported",
              "rule": "命令执行结果已播报（版本号 / 列表 / 错误信息）",
              "mode": "model"
            },
            {
              "id": "effect-verified",
              "rule": "安装或切换运行时后用 node --version 等命令验证已生效",
              "mode": "model"
            }
          ]
        }
      }
    }
  ]
}
